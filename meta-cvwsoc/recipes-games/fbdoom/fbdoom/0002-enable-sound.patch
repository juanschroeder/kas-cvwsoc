Enable sound support in fbdoom

Upstream-Status: Pending

diff --git a/fbdoom/Makefile b/fbdoom/Makefile
index fb32c7b..94d4b94 100644
--- a/fbdoom/Makefile
+++ b/fbdoom/Makefile
@@ -6,6 +6,11 @@
 #
 
 CROSS_COMPILE ?= #arm-linux-gnueabihf-
+FEATURE_SOUND ?= 0
+PKG_CONFIG ?= pkg-config
+
+SDL_CFLAGS ?= $(shell $(PKG_CONFIG) --cflags sdl)
+SDL_LIBS   ?= $(shell $(PKG_CONFIG) --libs sdl SDL_mixer)
 
 ifeq ($(V),1)
 	VB=''
@@ -36,6 +41,18 @@ OUTPUT=fbdoom
 SRC_DOOM = i_main.o dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_file_stdc_unbuffered.o w_main.o w_wad.o z_zone.o
 OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))
 
+ifeq ($(FEATURE_SOUND),1)
+override CFLAGS += -DFEATURE_SOUND $(SDL_CFLAGS)
+LIBS += $(SDL_LIBS)
+SRC_DOOM += i_sdlsound.o
+endif
+
+
+ifeq ($(FEATURE_MUSIC),1)
+CFLAGS += -DFEATURE_MUSIC
+SRC_DOOM += i_sdlmusic.o i_oplmusic.o
+endif
+
 all:	 $(OUTPUT)
 
 clean:
diff --git a/fbdoom/doomfeatures.h b/fbdoom/doomfeatures.h
index f7b15f7..dff6936 100644
--- a/fbdoom/doomfeatures.h
+++ b/fbdoom/doomfeatures.h
@@ -33,7 +33,7 @@
 
 // Enables sound output
 
-#undef FEATURE_SOUND
+//#undef FEATURE_SOUND
 
 #endif /* #ifndef DOOM_FEATURES_H */
 
diff --git a/fbdoom/i_sound.c b/fbdoom/i_sound.c
index 71947d2..5fee051 100644
--- a/fbdoom/i_sound.c
+++ b/fbdoom/i_sound.c
@@ -93,6 +93,9 @@ static sound_module_t *sound_modules[] =
 {
 #ifdef FEATURE_SOUND
     &sound_sdl_module,
+#endif
+
+#ifdef FEATURE_PCSOUND
     &sound_pcsound_module,
 #endif
     NULL,
@@ -102,7 +105,7 @@ static sound_module_t *sound_modules[] =
 
 static music_module_t *music_modules[] =
 {
-#ifdef FEATURE_SOUND
+#if defined(FEATURE_SOUND) && defined(FEATURE_MUSIC)
     &music_sdl_module,
     &music_opl_module,
 #endif
