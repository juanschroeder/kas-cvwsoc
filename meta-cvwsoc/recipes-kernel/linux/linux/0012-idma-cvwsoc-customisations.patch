+/*
+ * Optional DMA descriptor storage in uncached DDR.
+ *
+ * map the reserved physical range with MEMREMAP_WC, then register the CPU 
+ * mapping and the DMA/physical base together in a gen_pool.
+ */
+static int iis_idma_setup_local_desc_mem(struct platform_device *pdev,
+                                         struct iis_idma_device *idma_dev)
+{
+        struct device *dev = &pdev->dev;
+        struct device_node *mem_node;
+        struct reserved_mem *rmem;
+        struct gen_pool *pool;
+        void *local_mem;
+        int ret;
+
+        mem_node = of_parse_phandle(dev->of_node, "memory-region", 0);
+        if (!mem_node)
+                return 0;
+
+        rmem = of_reserved_mem_lookup(mem_node);
+        of_node_put(mem_node);
+        if (!rmem)
+                return dev_err_probe(dev, -EINVAL,
+                                     "invalid descriptor memory-region\n");
+
+        if (!IS_ALIGNED(rmem->base, __alignof__(struct iis_idma_hw_desc)) ||
+            !IS_ALIGNED(rmem->size, __alignof__(struct iis_idma_hw_desc)))
+                return dev_err_probe(dev, -EINVAL,
+                                     "descriptor memory-region is not %zu-byte aligned\n",
+                                     __alignof__(struct iis_idma_hw_desc));
+
+        if (rmem->size < sizeof(struct iis_idma_hw_desc))
+                return dev_err_probe(dev, -EINVAL,
+                                     "descriptor memory-region is too small\n");
+
+        local_mem = devm_memremap(dev, rmem->base, rmem->size, MEMREMAP_WC);
+        if (IS_ERR(local_mem))
+                return PTR_ERR(local_mem);
+        if (!local_mem)
+                return -ENOMEM;
+
+        pool = devm_gen_pool_create(dev,
+                                    ilog2(__alignof__(struct iis_idma_hw_desc)),
+                                    dev_to_node(dev), "iis-idma-desc");
+        if (IS_ERR(pool))
+                return PTR_ERR(pool);
+
+        ret = gen_pool_add_virt(pool, (unsigned long)local_mem, rmem->base,
+                                rmem->size, dev_to_node(dev));
+        if (ret)
+                return dev_err_probe(dev, ret,
+                                     "failed to add descriptor memory-region to pool\n");
+
+        idma_dev->local_desc_pool = pool;
+        dev_info(dev, "using local descriptor memory at %pa, size %#zx\n",
+                 &rmem->base, rmem->size);
+        return 0;
+}
