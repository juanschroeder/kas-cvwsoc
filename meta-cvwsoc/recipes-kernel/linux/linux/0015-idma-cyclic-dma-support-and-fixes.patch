+static struct dma_async_tx_descriptor *iis_idma_prep_dma_cyclic(
+                    struct dma_chan *chan, dma_addr_t buf_addr, size_t buf_len,
+                    size_t period_len, enum dma_transfer_direction direction,
+                    unsigned long flags)
+{
+        struct iis_idma_sw_desc *sw_desc;
+        struct iis_idma_channel *idma_chan;
+        size_t n_hw_descs;
+        size_t next_length;
+        size_t i = 0;
+
+        if (!chan || !buf_len || !period_len || buf_len % period_len)
+                return NULL;
+
+        /* DMA_DEV_TO_MEM unsupported for now */
+        if (direction != DMA_MEM_TO_DEV /*&& direction != DMA_MEM_TO_MEM*/)
+            return NULL;
+
+        if (period_len > IIS_IDMA_MAX_AXIS_DESC_BYTES)
+                return NULL;
+
+        n_hw_descs = DIV_ROUND_UP(buf_len, period_len);
+        idma_chan = to_idma_chan(chan);
+
+        sw_desc = iis_idma_desc_alloc_and_chain(idma_chan, n_hw_descs, 1);
+        if (sw_desc == NULL)
+                return NULL;
+
+
+        sw_desc->is_cyclic = true;
+        sw_desc->period_len = period_len;
+        sw_desc->buf_len = buf_len;
+        sw_desc->n_periods = buf_len / period_len;
+#ifdef DEBUG
+        sw_desc->dbg_hw_periods = 0;
+        sw_desc->dbg_vchan_pending = 0;
+#endif
+
+        dev_info(idma_chan->parent->dev,
+                "cyclic: buf=%pad buf_len=%zu period_len=%zu periods=%u hw_descs=%d\n",
+                &buf_addr, buf_len, period_len,
+                sw_desc->n_periods, sw_desc->n_hw_descs);
+
+        for (i = 0; i < n_hw_descs; ++i)
+        {
+                next_length = min_t(size_t, buf_len, period_len);
+                buf_len -= next_length;
+                sw_desc->hw_descs[i]->length = cpu_to_le32(next_length);
+                /* always interrupt on cyclic transfers, so we can update the current period */
+                sw_desc->hw_descs[i]->flags = cpu_to_le32(iis_idma_flags(DMA_CYCLIC, direction, 1));
+                if (direction == DMA_MEM_TO_DEV)
+                {
+                        sw_desc->hw_descs[i]->src = cpu_to_le64((u64)buf_addr);
+                        sw_desc->hw_descs[i]->dst = 0ULL;
+                }
+                /*
+                else if
+                {
+                        sw_desc->hw_descs[i]->src = 0ULL;
+                        sw_desc->hw_descs[i]->dst = cpu_to_le64((u64)buf_addr);
+                }
+                */
+                buf_addr += next_length;
+        }
+
+#ifdef DEBUG
+        pr_info("cyclic desc[0]: src=%#llx len=%u flags=%#x\n",
+                le64_to_cpu(sw_desc->hw_descs[0]->src),
+                le32_to_cpu(sw_desc->hw_descs[0]->length),
+                le32_to_cpu(sw_desc->hw_descs[0]->flags));
+#endif
+
+        return iis_idma_tx_prep(idma_chan, sw_desc, flags);
+}
